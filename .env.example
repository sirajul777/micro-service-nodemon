# ─────────────────────────────────────────────────────────────────────────────
# MikHMon — Microservices shared environment (Phase 0)
#
# Copy to `.env` and adjust. `docker-compose` reads DATABASE_*/REDIS_*/JWT_*
# variables from here and injects them into the services.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared Postgres (host credentials) ───────────────────────────────────
POSTGRES_USER=admin_mikrotik
POSTGRES_PASSWORD=super_postgres_password_123
POSTGRES_DB=db_mikrotik_app   # bootstrap DB; per-service DBs created by init script

# ── Redis (broker + cache) ───────────────────────────────────────────────
REDIS_PASSWORD=super_secure_redis_pass_123

# ── Gateway ──────────────────────────────────────────────────────────────
GATEWAY_PORT=80

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=kunci_rahasia_auth_identity_provider_999
SESSION_SECRET=mikhmon-session-secret

# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development

keya=mk_da253beb4c03f99b5ecb77b6a7aa6da3
