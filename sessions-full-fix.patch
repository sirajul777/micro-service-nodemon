+
+// ── Router sessions (CRUD) ─────────────────────────────────────────
+message RouterSessionInfo {
+  string id = 1;
+  string name = 2;
+  string ip = 3;
+  int32 port = 4;
+  string user = 5;
+  string hotspot_name = 6;
+  string dns_name = 7;
+  string currency = 8;
+  int32 reload_interval = 9;
+  string iface = 10;
+  int32 idle_to = 11;
+  string livereport = 12;
+  // password is intentionally never included in list/get responses.
+}
+
+message ListSessionsRequest {}
+message ListSessionsResponse {
+  bool success = 1;
+  string error = 2;
+  repeated RouterSessionInfo sessions = 3;
+}
+
+message GetSessionRequest {
+  string id = 1;
+}
+message GetSessionResponse {
+  bool success = 1;
+  string error = 2;
+  RouterSessionInfo session = 3;
+}
+
+message CreateSessionRequest {
+  string id = 1;
+  string name = 2;
+  string ip = 3;
+  int32 port = 4;
+  string user = 5;
+  string password = 6;
+  string hotspot_name = 7;
+  string dns_name = 8;
+  string currency = 9;
+  int32 reload_interval = 10;
+  string iface = 11;
+  int32 idle_to = 12;
+  string livereport = 13;
+}
+message CreateSessionResponse {
+  bool success = 1;
+  string error = 2;
+  RouterSessionInfo session = 3;
+}
+
+message UpdateSessionRequest {
+  string id = 1;
+  string name = 2;
+  string ip = 3;
+  int32 port = 4;
+  string user = 5;
+  // Empty password means "keep the existing password".
+  string password = 6;
+  string hotspot_name = 7;
+  string dns_name = 8;
+  string currency = 9;
+  int32 reload_interval = 10;
+  string iface = 11;
+  int32 idle_to = 12;
+  string livereport = 13;
+}
+message UpdateSessionResponse {
+  bool success = 1;
+  string error = 2;
+  RouterSessionInfo session = 3;
+}
+
+message DeleteSessionRequest {
+  string id = 1;
+}
+message DeleteSessionResponse {
+  bool success = 1;
+  string error = 2;
+}
