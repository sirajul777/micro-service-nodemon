# ─────────────── main-node-service (BFF) — Phase 8 env ───────────────
# Copy to .env and adjust. All values shown are sensible local defaults.

# HTTP port the BFF listens on (nginx routes to this).
PORT=8080

# Cookie session secret — MUST be a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Redis session store URL. Set this to enable shared sessions across
# multiple BFF instances. If omitted/blank, the BFF falls back to the
# in-memory MemoryStore (single-instance only — NOT recommended in prod).
REDIS_URL=redis://:redispass@redis:6379

# Downstream service endpoints (override for local dev, e.g. localhost).
AUTH_SERVICE_URL=http://auth-node-service:3001
ERP_SERVICE_URL=http://erp-node-service:3003
PAYMENT_SERVICE_URL=http://payment-service:3002
BOT_SERVICE_URL=http://bot-py-service:5000
MIKROTIK_GRPC_SERVER=mikrotik-go-service:50051

# Session key used to cache the downstream JWT after login.
BFF_AUTH_SESSION_KEY=mikhmon.jwt

