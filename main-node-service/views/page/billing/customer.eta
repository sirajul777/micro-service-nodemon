<div class="page" id="page-billing">
  <!-- Billing summary -->
  <div class="grid g4 billing-stats" id="bill-stats-grid">
    <div class="sbc c-blue">
      <div class="sbc-icon"><i class="fa fa-users"></i></div>
      <div>
        <div class="sbc-val" id="bill-total">0</div>
        <div class="sbc-lbl">Total Pelanggan</div>
      </div>
    </div>
    <div class="sbc c-green">
      <div class="sbc-icon"><i class="fa fa-check-circle"></i></div>
      <div>
        <div class="sbc-val" id="bill-active">0</div>
        <div class="sbc-lbl">Aktif</div>
      </div>
    </div>
    <div class="sbc c-red">
      <div class="sbc-icon"><i class="fa fa-exclamation-circle"></i></div>
      <div>
        <div class="sbc-val" id="bill-unpaid">0</div>
        <div class="sbc-lbl">Belum Bayar</div>
      </div>
    </div>
    <div class="sbc c-yellow">
      <div class="sbc-icon"><i class="fa fa-ban"></i></div>
      <div>
        <div class="sbc-val" id="bill-suspended">0</div>
        <div class="sbc-lbl">Diblokir</div>
      </div>
    </div>
  </div>

  <div class="card billing-customer-card">
    <div class="card-hd billing-card-header">
      <span class="billing-card-title"><i class="fa fa-users"></i> Daftar Pelanggan</span>
      <div class="billing-toolbar">
        <select id="bill-type-filter" onchange="loadBilling()">
          <option value="">Semua Tipe</option>
          <option value="pppoe">PPPoE</option>
          <option value="hotspot">Hotspot</option>
        </select>
        <select id="bill-status-filter" onchange="loadBilling()">
          <option value="">Semua Status</option>
          <option value="active">Aktif</option>
          <option value="suspended">Diblokir</option>
        </select>
        <button class="btn b-s b-sm" onclick="runOverdue()" title="Cek & blokir yang belum bayar">
          <i class="fa fa-ban"></i> Proses Overdue
        </button>
        <button class="btn b-s b-sm billing-import-btn" onclick="openImportBillingModal()">
          <i class="fa fa-upload"></i> Import JSON
        </button>
      </div>
    </div>

    <div class="billing-add-row">
      <button class="btn b-p b-sm" onclick="openBillCustomerModal()">
        <i class="fa fa-plus"></i> Tambah Pelanggan
      </button>
    </div>

    <div class="billing-table-wrap">
      <table class="billing-table">
        <thead>
          <tr>
            <th>Nama</th>
            <th>Username MikroTik</th>
            <th>Tipe</th>
            <th>Paket</th>
            <th>Tagihan/Bulan</th>
            <th>Tgl Tagih</th>
            <th>Status</th>
            <th>Telegram</th>
            <th>Aksi</th>
          </tr>
        </thead>
        <tbody id="t-billing"></tbody>
      </table>
    </div>
  </div>
</div>