    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/typeorm": "^11.0.3",
    "axios": "^1.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^5.3.2",
    "pg": "^8.11.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
