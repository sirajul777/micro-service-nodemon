+def _require_auth(self, permission: str | None = None) -> bool:
+    """Validate the bearer token and, if `permission` is given, enforce it
+    (admin role always passes — matches erp-node-service's JwtAuthGuard and
+    the reference monolith's PermissionsGuard).
+
+    Previously this only checked that the token was valid, with no role or
+    permission check at all — meaning any logged-in user (not just admins
+    with manageReseller/manageSystem) could create/edit/delete other
+    resellers' accounts, topup saldo, and read/edit Telegram bot tokens.
+    The monolith gates the equivalent routes with
+    @RequirePermission('manageReseller') / @RequirePermission('manageSystem')
+    at the controller level; this restores that here.
+    """
+    payload = _validate_token(self.headers.get("Authorization"))
+    if payload is None:
+        _json(self, 401, {"success": False, "message": "Unauthorized"})
+        return False
+    if permission and payload.get("role") != "admin":
+        perms = payload.get("permissions") or {}
+        if not perms.get(permission):
+            _json(self, 403, {"success": False, "message": "Anda tidak memiliki akses ke fitur ini"})
+            return False
+    return True
 
 
