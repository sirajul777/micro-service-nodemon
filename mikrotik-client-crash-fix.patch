 				if strings.HasPrefix(w, "=") {
-					eq := strings.IndexByte(w, '=')
-					key := w[1:eq]
-					val := w[eq+1:]
-					s[key] = val
+					// w is formatted "=key=value" (RouterOS API attribute
+					// word) — e.g. "=identity=MyRouter". The previous code
+					// searched for '=' from the start of w, which always
