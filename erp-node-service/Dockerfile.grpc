# Root-context ERP build so canonical gRPC contracts can be copied from mikrotik-go-service.
FROM node:22-alpine AS builder
WORKDIR /app

COPY erp-node-service/package.json erp-node-service/package-lock.json* ./
RUN npm install

COPY erp-node-service/ ./
COPY mikrotik-go-service/proto/router.proto /tmp/canonical-router.proto
COPY mikrotik-go-service/proto/reportproto/report_router.proto /tmp/canonical-report-router.proto

# The Go contracts carry an optional go_package declaration while the Node
# loader does not need it. Compare the wire-level contract after removing
# that language-specific declaration so drift in RPC/message definitions
# fails the build, while the valid language-specific option remains allowed.
RUN sed '/^[[:space:]]*option go_package[[:space:]]*=/d' proto/router.proto > /tmp/local-router.proto \
    && sed '/^[[:space:]]*option go_package[[:space:]]*=/d' /tmp/canonical-router.proto > /tmp/source-router.proto \
    && sed '/^[[:space:]]*option go_package[[:space:]]*=/d' proto/report_router.proto > /tmp/local-report-router.proto \
    && sed '/^[[:space:]]*option go_package[[:space:]]*=/d' /tmp/canonical-report-router.proto > /tmp/source-report-router.proto \
    && cmp -s /tmp/local-router.proto /tmp/source-router.proto \
    && cmp -s /tmp/local-report-router.proto /tmp/source-report-router.proto \
    && cp /tmp/canonical-router.proto proto/router.proto \
    && cp /tmp/canonical-report-router.proto proto/report_router.proto

RUN test -f src/main.ts
RUN test -f src/app.module.ts
RUN test -f src/report/report-internal.controller.ts
RUN test -f proto/erp_internal.proto
RUN test -f proto/report_internal.proto
RUN test -f proto/router.proto
RUN test -f proto/report_router.proto

RUN npm run build
RUN test -f dist/main.js
RUN test -f dist/app.module.js
RUN test -f dist/report/report-internal.controller.js

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/proto ./proto
RUN test -f /app/dist/main.js
RUN test -f /app/dist/app.module.js
RUN test -f /app/proto/erp_internal.proto
RUN test -f /app/proto/report_internal.proto
RUN test -f /app/proto/router.proto
RUN test -f /app/proto/report_router.proto
EXPOSE 3003 50053 50056
CMD ["node", "dist/main.js"]
