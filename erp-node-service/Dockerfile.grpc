# Root-context ERP build so canonical gRPC contracts can be copied from mikrotik-go-service.
FROM node:22-alpine AS builder
WORKDIR /app

COPY erp-node-service/package.json erp-node-service/package-lock.json* ./
RUN npm install

COPY erp-node-service/ ./
COPY mikrotik-go-service/proto/router.proto ./proto/router.proto
COPY mikrotik-go-service/proto/reportproto/report_router.proto ./proto/report_router.proto

RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/proto ./proto
RUN test -f /app/proto/erp_internal.proto
RUN test -f /app/proto/report_internal.proto
RUN test -f /app/proto/router.proto
RUN test -f /app/proto/report_router.proto
EXPOSE 3003 50053 50056
CMD ["node", "dist/main.js"]
